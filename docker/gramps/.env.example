# Copier en .env (gitignoré) à côté de ce fichier.

# Sous-domaine de l'arbre (enregistrement DNS A vers l'IP du VPS, comme arcadepipe).
GRAMPS_DOMAIN=arbre.pazpop.net

# Nom de l'arbre dans Gramps Web (créé vide s'il n'existe pas).
GRAMPS_TREE=Mon arbre

# Identifiant (nom du dossier) de l'arbre, à renseigner après le premier démarrage
# (`python3 -m gramps_webapi tree list`, voir README.md). Vide = on se fie au nom.
GRAMPS_TREE_ID=

# false au premier déploiement : Traefik ne route rien tant que le compte
# propriétaire n'existe pas. Passer à true, puis ./deploy.sh gramps (voir README.md).
GRAMPS_EXPOSE=false
