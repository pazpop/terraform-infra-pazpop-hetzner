[Unit]
Description=Backup quotidien de Gramps Web (arbre, comptes, clé, médias)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# User=deploy (groupe docker) : moindre privilège, pas de sudo.
User=deploy
WorkingDirectory=/home/deploy/backup-gramps
ExecStart=/home/deploy/backup-gramps/backup-gramps.sh
