# Copier en .env (gitignoré) à côté de ce fichier, puis remplir.
MJ_UTILISATEUR=mj

# Empreinte du mot de passe, jamais le mot de passe lui-même. Pour la fabriquer :
#   docker run --rm caddy:2.11.4-alpine caddy hash-password --plaintext "ton mot de passe"
# Dans ce fichier, chaque $ de l'empreinte s'écrit $$ (sinon Docker Compose le prend pour une variable).
MJ_MOT_DE_PASSE_HACHE=
